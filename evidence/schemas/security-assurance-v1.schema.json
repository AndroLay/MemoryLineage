{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorylineage.local/schemas/security-assurance-v1.schema.json",
  "title": "MemoryLineage bounded security assurance report",
  "type": "object",
  "required": [
    "report_type",
    "status",
    "formal_status",
    "execution",
    "registry_artifact",
    "chain_id",
    "valid_transitions",
    "stale_predecessor_cases",
    "sequence_gap_cases",
    "mutation_matrix",
    "invariants",
    "raw_memory_exported",
    "limitations"
  ],
  "properties": {
    "report_type": { "const": "memorylineage-bounded-security-assurance-v1" },
    "status": { "const": "BOUNDED_ASSURANCE_PASS" },
    "formal_status": { "const": "NOT_FORMALLY_VERIFIED" },
    "execution": { "type": "string" },
    "registry_artifact": { "type": "string" },
    "chain_id": { "type": "integer" },
    "valid_transitions": { "type": "integer", "minimum": 1 },
    "stale_predecessor_cases": { "$ref": "#/$defs/cases" },
    "sequence_gap_cases": { "$ref": "#/$defs/cases" },
    "mutation_matrix": {
      "type": "object",
      "required": ["total", "rejected", "all_expected"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "rejected": { "type": "integer", "minimum": 0 },
        "all_expected": { "const": true }
      }
    },
    "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } },
    "raw_memory_exported": { "const": false },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "expected", "observed", "status"],
      "properties": {
        "name": { "type": "string" },
        "expected": { "type": "string" },
        "observed": { "type": "string" },
        "status": { "const": "REJECTED" }
      }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "invariant": {
      "type": "object",
      "required": ["name", "status", "expected", "observed"],
      "properties": {
        "name": { "type": "string" },
        "status": { "const": "PASS" },
        "expected": { "type": "string" },
        "observed": { "type": "string" }
      }
    }
  }
}
