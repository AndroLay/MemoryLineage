{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorylineage.example/schemas/evidence-v1.json",
  "title": "MemoryLineage Inspector evidence export",
  "type": "object",
  "required": ["schemaVersion", "evidenceType", "network", "registry", "head", "transitions", "privacy"],
  "properties": {
    "schemaVersion": { "const": "memorylineage-evidence-v1" },
    "evidenceType": { "const": "memorylineage_inspector_export" },
    "network": {
      "type": "object",
      "required": ["name", "chainId"],
      "properties": {
        "name": { "type": "string" },
        "chainId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "registry": {
      "type": "object",
      "required": ["address", "spaceId"],
      "properties": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "spaceId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    },
    "head": {
      "type": "object",
      "required": ["sequence", "transitionId", "stateRoot"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "transitionId": { "type": "string" },
        "stateRoot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["spaceId", "sequence", "prevStateRoot", "nextStateRoot", "transitionId", "deltaCommitment", "provenanceCommitment", "profileId", "locatorCommitment"],
        "properties": {
          "spaceId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "sequence": { "type": "integer", "minimum": 1 },
          "prevStateRoot": { "type": "string" },
          "nextStateRoot": { "type": "string" },
          "transitionId": { "type": "string" },
          "deltaCommitment": { "type": "string" },
          "provenanceCommitment": { "type": "string" },
          "profileId": { "type": "string" },
          "locatorCommitment": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "attack": { "type": "object" },
    "privacy": {
      "type": "object",
      "required": ["rawMemoryOnChain"],
      "properties": { "rawMemoryOnChain": { "const": false } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
