{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorylineage.example/schemas/evidence-v2.json",
  "title": "MemoryLineage portable evidence v2",
  "type": "object",
  "required": ["schemaVersion", "evidenceType", "network", "registry", "spec", "head", "transitions", "authorizationHistory", "observations", "privacy", "verificationMetadata"],
  "properties": {
    "schemaVersion": { "const": "memorylineage-evidence-v2" },
    "evidenceType": { "const": "memorylineage_evidence_v2" },
    "sourceClass": {
      "enum": ["DEMO_SPACE_V2_LOCAL", "PROTOCOL_CORPUS_LOCAL", "SEPOLIA_REFERENCE_OBSERVATION", "LEGACY_UNDECLARED"]
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "registry": {
      "type": "object",
      "required": ["address", "spaceId"],
      "properties": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "codeHash": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
        "spaceId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["name", "snapshot"],
      "properties": {
        "name": { "type": "string" },
        "snapshot": { "type": "string" },
        "vectorHash": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "head": { "$ref": "#/$defs/head" },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    },
    "authorizationProofs": {
      "type": "array",
      "items": { "$ref": "#/$defs/authorizationProof" }
    },
    "authorizationHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["controller", "authorizer", "configNonce"],
        "properties": {
          "controller": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "authorizer": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "configNonce": { "type": "integer", "minimum": 0 },
          "effectiveFromSequence": { "type": ["integer", "null"], "minimum": 1 },
          "label": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "attack": {
      "anyOf": [
        { "$ref": "#/$defs/attack" },
        { "type": "null" }
      ]
    },
    "privacy": {
      "type": "object",
      "required": ["rawMemoryOnChain"],
      "properties": { "rawMemoryOnChain": { "const": false } },
      "additionalProperties": false
    },
    "verificationMetadata": {
      "type": "object",
      "required": ["producer"],
      "properties": {
        "producer": { "type": "string" },
        "generatedAt": { "type": ["string", "null"] },
        "legacySource": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "network": {
      "type": "object",
      "required": ["name", "chainId"],
      "properties": {
        "name": { "type": "string" },
        "chainId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "head": {
      "type": "object",
      "required": ["transitionId", "stateRoot", "sequence"],
      "properties": {
        "transitionId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "stateRoot": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "sequence": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["spaceId", "sequence", "prevStateRoot", "deltaCommitment", "provenanceCommitment", "profileId", "locatorCommitment", "transitionId", "nextStateRoot"],
      "properties": {
        "spaceId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "prevStateRoot": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "deltaCommitment": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "provenanceCommitment": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "profileId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "locatorCommitment": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "transitionId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "nextStateRoot": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    },
    "authorizationProof": {
      "type": "object",
      "required": ["sequence", "transitionId", "authorizer", "authorizationType", "chainId", "verifyingContract", "structHash", "domainSeparator", "signingDigest", "signature"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "configNonce": { "type": ["integer", "null"], "minimum": 0 },
        "transitionId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "authorizer": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "authorizationType": { "const": "EOA_EIP712" },
        "chainId": { "type": "string", "pattern": "^[0-9]+$" },
        "verifyingContract": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "structHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "domainSeparator": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "signingDigest": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["providerLabel", "observedHead"],
      "properties": {
        "providerLabel": { "type": "string" },
        "observedHead": { "$ref": "#/$defs/head" }
      },
      "additionalProperties": false
    },
    "attack": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "reason": { "type": ["string", "null"] },
        "restoredSnapshotSequence": { "type": ["integer", "null"], "minimum": 0 },
        "attemptedSequence": { "type": ["integer", "null"], "minimum": 0 },
        "stalePredecessor": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
        "canonicalPredecessor": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
        "executionSource": { "type": ["string", "null"] },
        "transactionBroadcast": { "type": ["boolean", "null"] },
        "fixtureId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
